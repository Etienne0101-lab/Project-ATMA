# Project ATMA - Codeine Configuration Example
# 
# Copy this file to .env.codeine and fill in your values.
# NEVER commit this file to version control!
#
# This file contains sensitive API keys and tokens.
# Add .env.codeine to your .gitignore file.
#
# ============================================================================
# CODEINE ASSISTANT CONFIGURATION
# ============================================================================

# Backend selection
CODEINE_BACKEND=groq

# Model selection
CODEINE_MODEL=codeine-7b
CODEINE_FALLBACK=DeepHat/DeepHat-V1-7B
DEEPHAT_MODEL=DeepHat/DeepHat-V1-7B

# Ollama configuration
OLLAMA_HOST=http://localhost:11434

# Edge API configuration (Groq, Featherless, etc.)
CODEINE_EDGE_URL=https://api.groq.com/openai/v1
CODEINE_EDGE_KEY=
GROQ_API_KEY=

# Gateway configuration
CODEINE_GATEWAY_URL=http://localhost:8787
CODEINE_GATEWAY_TOKEN=your_secure_gateway_token

# ============================================================================
# TRAINING PIPELINE CONFIGURATION
# ============================================================================

# Directories
CODEINE_DATA_DIR=./data/codeine
CODEINE_MODEL_DIR=./models/codeine
CODEINE_OUTPUT_DIR=./output/codeine
CODEINE_CACHE_DIR=./cache/codeine

# Model settings
CODEINE_BASE_MODEL=Qwen2.5-Coder-7B
CODEINE_OUTPUT_MODEL=codeine-7b

# Training settings
CODEINE_BATCH_SIZE=4
CODEINE_GRADIENT_ACCUMULATION_STEPS=4
CODEINE_LEARNING_RATE=2e-5
CODEINE_NUM_EPOCHS=3
CODEINE_MAX_SEQ_LENGTH=4096

# LoRA settings
CODEINE_USE_LORA=true
CODEINE_LORA_RANK=64
CODEINE_LORA_ALPHA=128
CODEINE_LORA_DROPOUT=0.05

# Languages to include in training
CODEINE_LANGUAGES=python,go,javascript,typescript,java,c,cpp,csharp,rust,bash,powershell,yaml,json

# ============================================================================
# GATEWAY CONFIGURATION
# ============================================================================

# Gateway settings
GATEWAY_PORT=8787
METRICS_PORT=9090
LOG_LEVEL=info

# External service URLs
MYTHIC_URL=https://127.0.0.1:7443
MYTHIC_INSECURE_TLS=0
OLLAMA_URL=http://localhost:11434

# ============================================================================
# MONITORING & TRACKING
# ============================================================================

# Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=codeine-training
WANDB_ENTITY=project-atma

# Hugging Face
HUGGINGFACE_TOKEN=
HUGGINGFACE_REPO=Etienne0101-lab/codeine-7b

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Docker registry
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=
DOCKER_TOKEN=

# ============================================================================
# PRODUCTION DEPLOYMENT
# ============================================================================

# Traefik (reverse proxy)
TRAEFIK_DOMAIN=your-domain.com
TRAEFIK_EMAIL=your-email@example.com
TRAEFIK_BASIC_AUTH=
TRAEFIK_RATE_LIMIT=100
TRAEFIK_IP_WHITELIST=0.0.0.0/0

# SSH deployment
SERVER_HOST=
SERVER_PORT=22
SERVER_USER=root
SSH_PRIVATE_KEY=

# ============================================================================
# NOTES
# ============================================================================

# 1. All API keys should be long, random strings
# 2. Never share these keys or commit them to version control
# 3. Rotate keys regularly for security
# 4. Use different keys for different services
# 5. For production, use a secrets manager (Vault, AWS Secrets, etc.)
# 6. The gateway token is used for client authentication
# 7. API keys are used for external service authentication
# 8. Set MYTHIC_INSECURE_TLS=1 only for development with self-signed certs

# To generate a secure gateway token:
#   openssl rand -hex 32
#   or: python -c "import secrets; print(secrets.token_hex(32))"

# To generate basic auth for Traefik:
#   htpasswd -nb admin your_password | openssl passwd -apr1 -stdin
