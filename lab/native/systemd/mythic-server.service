[Unit]
Description=Mythic server (native, no Docker)
After=network.target postgresql.service rabbitmq-server.service
Wants=postgresql.service rabbitmq-server.service

[Service]
Type=simple
User=mythic
Group=mythic
# Both .env location and migrations location are tied to this directory:
# - mythic_server reads .env from the executable's directory (utils/config.go)
# - database/migrations is read relative to the working directory (database/initialize.go)
# So the binary, .env, database/migrations and static/ must all live in /opt/mythic/bin.
WorkingDirectory=/opt/mythic/bin
EnvironmentFile=/opt/mythic/bin/.env
# TCP probes only: rabbitmqctl needs the Erlang cookie and fails as the mythic
# user; pg_isready is not guaranteed on a minimal host. TCP connect is enough
# to gate startup — the server itself will fail loudly if auth is wrong.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do (exec 3<>/dev/tcp/127.0.0.1/5432) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do (exec 3<>/dev/tcp/127.0.0.1/5672) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStartPre=/bin/bash -c 'test -d /opt/mythic/bin/database/migrations && test -f /opt/mythic/bin/.env'
ExecStart=/opt/mythic/bin/mythic_server
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ReadWritePaths=/opt/mythic /var/lib/mythic
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
