[Unit]
Description=Hasura GraphQL for Mythic (native, no Docker)
After=network.target postgresql.service mythic-server.service
Wants=postgresql.service

[Service]
Type=simple
User=mythic
Group=mythic
WorkingDirectory=/opt/mythic/bin
# Do NOT put HASURA_GRAPHQL_DATABASE_URL here with ${postgres_password}:
# systemd does not reliably expand EnvironmentFile variables inside
# Environment= lines. bin/hasura-wrapper.sh sources bin/.env in shell
# and exports the constructed URLs itself.
ExecStart=/opt/mythic/bin/hasura-wrapper.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
