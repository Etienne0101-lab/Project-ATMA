[Unit]
Description=Mythic native agent/C2 service %i (no Docker)
After=network.target mythic-server.service rabbitmq-server.service
Wants=mythic-server.service rabbitmq-server.service

[Service]
Type=simple
User=mythic
Group=mythic
# %i is the service directory name under /opt/mythic/InstalledServices/<name>.
# Each service directory must contain:
#   main       — the agent service executable (Go binary, or a wrapper script
#                for Python agents that execs python3 main.py)
#   agent.env  — 0600 env file with RABBITMQ_HOST/USER/PASSWORD/VHOST and
#                MYTHIC_SERVER_HOST/MYTHIC_SERVER_GRPC_PORT
# Verified with Poseidon (Go): building main.go and running it with this
# unit syncs the payload type into mythic_server via RabbitMQ + gRPC,
# exactly as the Docker container service does.
WorkingDirectory=/opt/mythic/InstalledServices/%i
EnvironmentFile=/opt/mythic/InstalledServices/%i/agent.env
ExecStart=/opt/mythic/InstalledServices/%i/main
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
